# Xiaomi 17 Max (byron) — 由 tools/port/gen_byron_config.py 生成
# 生成时间: 2026-11-21 00:10:18
# 数据源: firmware diff + 真机只读采集 + 人工探测。
# BOARD_DATA_COMPLETE=yes 仅在 --attest（真机启动已验证）时写入。

PROFILE_NAME="Xiaomi 17 Max"
CODENAME=byron
PRODUCT_MODEL=2605EPN8EC
SOC=SM8850-AC
SOC_PLATFORM=kaanapali
PANEL="2608x1200 LTPO AMOLED 120Hz"
REAR_DISPLAY=none
BATTERY="8000mAh 金沙江 / P3+G2"
ADRENO=840
BOARD_DATA_COMPLETE=no

# ---- 目标 iOS（项目原生版本 iOS 16.7.16 / 20H392）----
# 用户 2026-11-21 一度指定 16.5，但因 cryptex/trustcache 布局与项目硬编码不兼容，
# 决定回退到原仓库验证过的 16.7.16。IPSW 已校验：SHA256 与官方一致、当前仍签名。
# kernel 编译参数不变（xnu.yml macos_version=13.5 → xnu-8796）。
IOS_VERSION=16.7.16
IOS_BUILD=20H392
IPSW_TARGET="iPhone10,3,iPhone10,6_16.7.16_20H392_Restore.ipsw"
IPSW_SHA256="ece1194f7e233e9109c5790a8d23a4564a10a254e15ec5b09978a343265568fb"
# cryptex/trustcache 构建号由 tools/port/discover_ipsw_assets.py 从 IPSW 解析,
# 落在 device/byron/ipsw_assets.env（当前=087-86698-044 / 087-86593-047 / 087-86715-047）。
IPSW_ASSETS=device/byron/ipsw_assets.env

KERNEL_CONFIG=PANDORA
XNU_PATCH_SERIES=xnu/patches
SHIM=shim/loader
LAUNCHER=mac/boot_ios.sh
EXTENTS_DIR=device/byron/extents
STOCK_BOOT_B=device/byron/stock/boot_b.img

