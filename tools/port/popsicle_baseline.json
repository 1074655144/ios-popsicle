{
  "meta": {
    "device": "popsicle",
    "name": "Xiaomi 17 Pro Max",
    "soc": "SM8850",
    "derived_from": [
      "device/DT_FINDINGS.md",
      "tools/mkadt_pandora.py",
      "xnu/patches/0333-0367-popsicle-*.patch",
      "shim/loader/loader.c",
      "README.md"
    ],
    "note": "values are the upstream board's measured/recorded values. class=soc_shared means the same SM8850 platform constant can very likely be reused on byron (SM8850-AC), but must still be verified against byron's own DTBO. class=board_specific means it has to be re-collected."
  },
  "params": [
    {"key": "gicd_base", "value": "0x17000000", "class": "soc_shared", "source": "fdt", "extract": "gicd", "required": true, "targets": ["tools/mkadt_pandora.py:GICD"], "note": "GICv3 distributor; DT_FINDINGS 第二轮"},
    {"key": "gicr_base", "value": "0x17080000", "class": "soc_shared", "source": "fdt", "extract": "gicr", "required": true, "targets": ["tools/mkadt_pandora.py:GICR"], "note": "8 redistributors"},
    {"key": "gicr_stride", "value": "0x40000", "class": "soc_shared", "source": "fdt", "extract": "gicr_stride", "required": true, "targets": ["tools/mkadt_pandora.py:GICR_SIZE"], "note": "redistributor-stride property (Qualcomm writes <0 0x40000>)"},
    {"key": "timer_freq", "value": "19200000", "class": "soc_shared", "source": "fdt", "extract": "timer_freq", "required": true, "targets": ["tools/mkadt_pandora.py:TIMEBASE"], "note": "arm,armv8-timer clock-frequency"},
    {"key": "vtimer_intid", "value": "27", "class": "soc_shared", "source": "fdt", "extract": "vtimer_intid", "required": true, "targets": ["tools/mkadt_pandora.py:VTIMER_INTID"], "note": "PPI 11 -> INTID 27 (SM8850 uses standard numbering, unlike older QCOM)"},
    {"key": "mpidrs", "value": "[0x0,0x100,0x200,0x300,0x400,0x500,0x10000,0x10100]", "class": "soc_shared", "source": "fdt", "extract": "mpidrs", "required": true, "targets": ["tools/mkadt_pandora.py:MPIDRS"], "note": "6 E cores + 2 P cores"},
    {"key": "psci_method", "value": "smc", "class": "soc_shared", "source": "fdt", "extract": "psci", "required": true, "targets": ["xnu kernel psci init"], "note": "arm,psci-1.0"},
    {"key": "ufs_base", "value": "0x01d84000", "class": "soc_shared", "source": "fdt", "extract": "ufs", "required": true, "targets": ["tools/mkadt_pandora.py:UFS"], "note": "UFSHCI 4.0, legacy single doorbell at handoff"},
    {"key": "ufs_smmu_sid", "value": "0x60", "class": "soc_shared", "source": "fdt", "extract": "ufs_smmu_sid", "required": true, "targets": ["xnu/patches (SmmuTakeover)"], "note": "bootloader leaves SID 0x60 in passthrough context 0 (UFS iommus 2nd cell)"},
    {"key": "spmi_arb_base", "value": "0xc400000", "class": "soc_shared", "source": "fdt", "extract": "spmi", "required": true, "targets": ["xnu/patches power key driver"], "note": "qcom,canoe-spmi-pmic-arb, v8"},
    {"key": "mdp_base", "value": "0x09800000", "class": "soc_shared", "source": "fdt", "extract": "mdp", "required": true, "targets": ["xnu/patches scanout/GPU"], "note": "qcom,mdss_mdp"},
    {"key": "memory_banks", "value": "[[0x80000000,0x80000000],[0x100000000,0xfcc00000]]", "class": "board_specific", "source": "fdt", "extract": "memory", "required": true, "targets": ["tools/mkadt_pandora.py:PHYS_BASE/MEM_SIZE/HIGH_MEM_SIZE"], "note": "RAM size differs by SKU; byron 基础 DTB 的 /memory 是 <0 0> 占位符，ABL 启动填写，必须真机读取"},
    {"key": "phys_base", "value": "0x8c0000000", "class": "board_specific", "source": "manual", "required": true, "targets": ["tools/mkadt_pandora.py:PHYS_BASE"], "note": "chosen clean 5 GiB bank; must be recomputed from byron /memory + reserved-memory"},
    {"key": "dsp_shm", "value": "0xb0000000", "class": "board_specific", "source": "manual", "required": true, "targets": ["tools/mkadt_pandora.py:DSP_SHM"], "note": "ADSP takes 32-bit addresses; must be free DRAM, no fixed carve-out"},
    {"key": "splash_base", "value": "0xfc800000", "class": "board_specific", "source": "fdt", "extract": "splash_base", "required": true, "targets": ["tools/mkadt_pandora.py:FB", "shim/loader/loader.c"], "note": "reserved-memory cont_splash_region; bootloader keeps scanning out here"},
    {"key": "splash_size", "value": "0x2b00000", "class": "board_specific", "source": "fdt", "extract": "splash_size", "required": true, "targets": ["tools/mkadt_pandora.py:FB_SIZE"], "note": "must equal ABL's scanout buffer size; byron DTBO 里是 0x0 占位符，由 ABL 启动填写，必须真机读取"},
    {"key": "fb_w", "value": "1200", "class": "board_specific", "source": "live", "required": true, "targets": ["tools/mkadt_pandora.py:FB_W", "xnu/patches/0334-popsicle-scanout-panel-size.patch:SC_PANEL_W"], "note": "measured by shim/hello + SSPP registers, NOT the panel's physical width"},
    {"key": "fb_h", "value": "2608", "class": "board_specific", "source": "live", "required": true, "targets": ["tools/mkadt_pandora.py:FB_H", "xnu/patches/0334-popsicle-scanout-panel-size.patch:SC_PANEL_H"], "note": "byron's public spec is also 1200x2608, but the framebuffer must be measured"},
    {"key": "fb_stride", "value": "4800", "class": "board_specific", "source": "live", "required": true, "targets": ["tools/mkadt_pandora.py:FB_STRIDE", "shim/loader/loader.c"], "note": "read SSPP source stride register; do NOT assume width*4"},
    {"key": "fb_format", "value": "ARGB8888", "class": "board_specific", "source": "live", "required": true, "targets": ["shim/loader/loader.c"], "note": "SSPP format register at +0x30"},
    {"key": "panel_phys_w", "value": "1220", "class": "board_specific", "source": "fdt", "extract": "panel_phys_w", "required": true, "targets": ["xnu/patches (DSC / panel timings)"], "note": "physical panel resolution from DT, distinct from framebuffer"},
    {"key": "panel_phys_h", "value": "2656", "class": "board_specific", "source": "fdt", "extract": "panel_phys_h", "required": true, "targets": ["xnu/patches (DSC / panel timings)"], "note": "byron DTBO 实测 1200x2608 (qcom,mdss-dsi-panel-width/height), 与公网规格一致"},
    {"key": "panel_mode", "value": "command-mode DSC 30bpp 24-120Hz", "class": "board_specific", "source": "fdt", "extract": "panel_mode", "required": true, "targets": ["xnu/patches scanout", "shim/loader"], "note": "command mode means ABL's buffer keeps self-refreshing after handoff"},
    {"key": "rear_display", "value": "present (572x904 FocalTech, DSI1)", "class": "board_specific", "source": "fdt", "extract": "rear_display", "required": true, "targets": ["xnu/patches (secondary panel + touch)", "tools/mkadt_pandora.py"], "note": "byron DTBO 已确认无副屏、无 FocalTech；删掉这些驱动反而简化移植"},
    {"key": "touch_main", "value": "synaptics,tcm-spi @0x1a80000 (QUP4 SE0 / spi19)", "class": "board_specific", "source": "fdt", "extract": "touch_main", "required": true, "targets": ["xnu/patches pandora_touch", "tools/mkadt_pandora.py"], "note": "TouchComm v1; byron DTBO 同厂 synaptics,tcm-spi, irq GPIO 158 / reset GPIO 66"},
    {"key": "touch_irq_gpio", "value": "158", "class": "board_specific", "source": "live", "required": true, "targets": ["xnu/patches pandora_touch"], "note": "TLMM GPIO; distinguish main vs rear by /proc/interrupts counter while touching"},
    {"key": "touch_reset_gpio", "value": "66", "class": "board_specific", "source": "fdt", "extract": "touch_reset_gpio", "required": true, "targets": ["xnu/patches pandora_touch"], "note": "synaptics,reset-gpio 2nd cell; plus avdd GPIO 117 / iovdd RPMh L4I_E0"},
    {"key": "touch_secondary", "value": "focaltech,fts @0x1988000 irq201", "class": "board_specific", "source": "fdt", "extract": "touch_secondary", "required": false, "expected_absent": true, "targets": ["xnu/patches (secondary touch)"], "note": "expected ABSENT on byron (no rear screen); absence is the correct result"},
    {"key": "vol_up_gpio", "value": "101", "class": "board_specific", "source": "fdt", "extract": "vol_up", "required": true, "targets": ["xnu/patches gpio keys"], "note": "TLMM, active low"},
    {"key": "tlmm_base_dt", "value": "0x0f000000", "class": "soc_shared", "source": "fdt", "extract": "tlmm_dt", "required": true, "targets": ["xnu/patches"], "note": "what the DT claims (pinctrl@f000000, qcom,canoe-tlmm)"},
    {"key": "tlmm_base_real", "value": "0x0f100000", "class": "soc_shared", "source": "live", "required": true, "targets": ["xnu/patches 0343 WL_TLMM_PA and all GPIO drivers"], "note": "CRITICAL: the real base is 0x0f100000, NOT the DT value. Reading 0x0f065000 hangs the SoC (upstream t2 test). GPIO n = 0x100000 + 0x1000*n"},
    {"key": "tdm_slots", "value": "4", "class": "board_specific", "source": "fdt", "extract": "tdm_slots", "required": true, "targets": ["xnu/patches/0342-popsicle-tdm-four-slots.patch"], "note": "qcom,tdm-max-slots; byron DTBO 实测 2（立体声双扬），4-slot 补丁必须改"},
    {"key": "wifi_chip", "value": "WCN7880 (peach) PCIe RC0", "class": "board_specific", "source": "fdt", "extract": "wifi", "required": false, "targets": ["xnu/patches/0343-0367 WLAN series"], "note": "byron DTBO 是 qcom,wcn786x，不是 WCN7880；WLAN 系列补丁的板级文件/电压表要换"},
    {"key": "thermal_table", "value": "/data/vendor/thermal/decrypt.txt (7 body inputs)", "class": "board_specific", "source": "live", "required": true, "targets": ["xnu/patches/0333,0335,0337,0339,0340"], "note": "byron 8000mAh + different chassis: all thresholds and the 95C junction hysteresis must be redone"},
    {"key": "battery_gauge", "value": "7500mAh", "class": "board_specific", "source": "live", "required": true, "targets": ["xnu/patches pandora_gauge"], "note": "byron 8000mAh + P3/G2 charging ICs"},
    {"key": "charger_ic", "value": "P3/G2", "class": "board_specific", "source": "live", "required": true, "targets": ["xnu/patches charging"], "note": "read /sys/class/power_supply + vendor DTBO"},
    {"key": "brightness_dcs", "value": "DCS 0x51, 7..0x3fff, normal cap 0x1554", "class": "board_specific", "source": "live", "required": true, "targets": ["xnu/patches/0139-0141 backlight"], "note": "DSI test-pattern FIFO kickoff; byron's M10 panel uses a different range"},
    {"key": "page_size_16k", "value": "unknown", "class": "soc_shared", "source": "live", "required": true, "targets": ["shim/hello probe"], "note": "XNU wants 16K pages; must be probed in a tiny bootloader before committing to a port"},
    {"key": "abl_load_addr", "value": "unknown", "class": "board_specific", "source": "live", "required": true, "targets": ["shim/loader/start.S"], "note": "where ABL places the payload; upstream step 1 probe"},
    {"key": "userdata_dev", "value": "sda34 (may swap to sdb34)", "class": "board_specific", "source": "live", "required": true, "targets": ["mac/phone_prepare.sh"], "note": "always resolve /dev/block/by-name/userdata, never hardcode sdX"},
    {"key": "userdata_lba", "value": "0..1000869848", "class": "board_specific", "source": "live", "required": true, "targets": ["tools/pinfile rawwrite"], "note": "dm-default-key table: full-block mapping, offset 0"},
    {"key": "pinned_extents", "value": "iosroot/ioslog/adspfw .json", "class": "board_specific", "source": "build", "required": true, "targets": ["device/byron/extents/", "mac/phone_prepare.sh"], "note": "generated by phone_prepare.sh on the byron unit; FIEMAP positions are device-specific"},
    {"key": "firmware_files", "value": "ADSP / WCN7880 / CS35L43 / ACDB", "class": "board_specific", "source": "firmware", "required": true, "targets": ["xnu/patches fw packs", "tools/mkfwpack.py"], "note": "extract from /vendor/firmware_mnt (vendor 分区尚未解包); byron 是 WCN786x; never commit vendor blobs"},
    {"key": "stock_boot_b_sha256", "value": "n/a", "class": "board_specific", "source": "build", "required": true, "targets": ["backup/manifest.txt"], "note": "tools/backup.sh on the byron unit, before any bootmgr experiment"}
  ]
}
