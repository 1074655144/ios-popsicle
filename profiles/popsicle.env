# Xiaomi 17 Pro Max (popsicle) — 上游 ios-popsicle 已跑通的板级配置
# BOARD_DATA_COMPLETE=yes 表示「上游仓库已经采集过板级数据」，
# 不代表本工作区验证过真机；每次启动仍会做备份、分区与 pinned 文件校验。

PROFILE_NAME="Xiaomi 17 Pro Max"
CODENAME=popsicle
PRODUCT_MODEL="Xiaomi 17 Pro Max"
SOC=SM8850
SOC_PLATFORM=canoe
PANEL="2608x1200 LTPO AMOLED 120Hz + 2.9in 背屏"
REAR_DISPLAY=yes
BATTERY="7500mAh"
ADRENO=840
BOARD_DATA_COMPLETE=yes

KERNEL_CONFIG=PANDORA
XNU_PATCH_SERIES=xnu/patches
SHIM=shim/loader
LAUNCHER=mac/boot_ios.sh
EXTENTS_DIR=mac/extents
STOCK_BOOT_B=device/stock/boot_b.img
